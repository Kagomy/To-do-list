<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mello App Clone</title>
    <style>
        /* ====== تنسيقات CSS ====== */
        * {
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f9f9f9;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            transition: background-color 0.3s;
        }

        /* الحاوية الرئيسية */
        .app-container {
            width: 100%;
            max-width: 450px;
            background: white;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        /* ====== شكل النافذة القديمة ====== */
        .retro-window {
            border: 2px solid #000;
            background: white;
            box-shadow: 5px 5px 0px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .window-header {
            background: #e0e0e0;
            padding: 6px 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #000;
        }

        .window-title {
            font-size: 12px;
            font-weight: bold;
            color: #333;
        }

        .window-dots {
            display: flex;
            gap: 5px;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            border: 1px solid rgba(0,0,0,0.1);
        }

        .dot.red { background: #ff5f56; }
        .dot.yellow { background: #ffbd2e; }
        .dot.green { background: #27c93f; }

        .window-content {
            padding: 15px;
            display: flex;
            gap: 15px;
        }

        /* صورة البروفايل */
        .avatar {
            width: 80px;
            height: 80px;
            background: #C5CAE9;
            border: 1px solid #ccc;
            border-radius: 8px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 30px;
            transition: background 0.3s;
        }

        /* حقول البيانات */
        .profile-info {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .field label {
            font-size: 10px;
            color: #777;
            display: block;
            margin-bottom: 2px;
        }

        .field input {
            width: 100%;
            padding: 5px 8px;
            font-size: 12px;
            border: 1px solid #ccc;
            border-radius: 4px;
            background: #e8eaf6;
            transition: background 0.3s;
        }

        .row-fields {
            display: flex;
            gap: 8px;
        }

        .row-fields .field {
            flex: 1;
        }

        /* ====== قائمة المهام ====== */
        .todo-section {
            margin-top: 10px;
        }

        .todo-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .todo-header h2 {
            font-size: 18px;
            margin: 0;
            color: #333;
        }

        .add-btn {
            background: #C5CAE9;
            border: none;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            font-size: 20px;
            cursor: pointer;
            color: #333;
            font-weight: bold;
            transition: background 0.3s;
        }

        .add-btn:hover {
            opacity: 0.8;
        }

        /* قائمة المهام */
        #task-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .task-item {
            display: flex;
            align-items: center;
            background: white;
            border: 1px solid #eee;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 8px;
            box-shadow: 2px 2px 5px rgba(0,0,0,0.05);
        }

        .task-item input[type="checkbox"] {
            margin-right: 10px;
            cursor: pointer;
        }

        .task-text {
            flex: 1;
            font-size: 14px;
            color: #333;
        }

        .task-text.done {
            text-decoration: line-through;
            color: #aaa;
        }

        .delete-btn {
            background: none;
            border: none;
            color: #ff5f56;
            font-size: 18px;
            cursor: pointer;
            padding: 0 5px;
        }

        /* ====== نافذة تغيير الألوان ====== */
        .color-picker-container {
            margin-top: 20px;
            text-align: center;
            border-top: 1px solid #eee;
            padding-top: 15px;
        }

        .color-picker-container p {
            font-size: 12px;
            color: #666;
            margin-bottom: 10px;
        }

        .color-options {
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        .color-circle {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid white;
            box-shadow: 0 0 3px rgba(0,0,0,0.2);
            transition: transform 0.2s;
        }

        .color-circle:hover {
            transform: scale(1.2);
        }
    </style>
</head>
<body>

    <div class="app-container">
        <!-- 1. بروفايل المستخدم -->
        <div class="retro-window">
            <div class="window-header">
                <span class="window-title">_.exe</span>
                <div class="window-dots">
                    <div class="dot red"></div>
                    <div class="dot yellow"></div>
                    <div class="dot green"></div>
                </div>
            </div>
            <div class="window-content">
                <div class="avatar" id="avatar-box">👤</div>
                <div class="profile-info">
                    <div class="field">
                        <label>Full Name</label>
                        <input type="text" id="fullname" value="Mello User">
                    </div>
                    <div class="row-fields">
                        <div class="field">
                            <label>Grade</label>
                            <input type="text" id="grade" value="111">
                        </div>
                        <div class="field">
                            <label>Birthday</label>
                            <input type="text" id="birthday" value="July 19">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. قائمة المهام -->
        <div class="todo-section">
            <div class="todo-header">
                <h2>My To-Do List</h2>
                <button class="add-btn" onclick="addTask()">+</button>
            </div>
            <ul id="task-list">
                <!-- المهام هتتضاف هنا عن طريق الجافاسكريبت -->
            </ul>
        </div>

        <!-- 3. اختيار الألوان -->
        <div class="color-picker-container">
            <p>Choose Theme Color</p>
            <div class="color-options">
                <div class="color-circle" style="background: #C5CAE9;" onclick="changeColor('#C5CAE9')"></div>
                <div class="color-circle" style="background: #E1BEE7;" onclick="changeColor('#E1BEE7')"></div>
                <div class="color-circle" style="background: #FFF9C4;" onclick="changeColor('#FFF9C4')"></div>
                <div class="color-circle" style="background: #F8BBD0;" onclick="changeColor('#F8BBD0')"></div>
                <div class="color-circle" style="background: #B2DFDB;" onclick="changeColor('#B2DFDB')"></div>
                <div class="color-circle" style="background: #FFCCBC;" onclick="changeColor('#FFCCBC')"></div>
            </div>
        </div>
    </div>

    <script>
        // ====== كود JavaScript ======
        
        // مصفوفة المهام
        let tasks = [];

        // تحميل المهام واللون من ذاكرة المتصفح (localStorage)
        window.onload = function() {
            // تحميل اللون
            const savedColor = localStorage.getItem('themeColor');
            if (savedColor) {
                changeColor(savedColor);
            }

            // تحميل المهام
            const savedTasks = localStorage.getItem('tasks');
            if (savedTasks) {
                tasks = JSON.parse(savedTasks);
                renderTasks();
            } else {
                // مهام افتراضية لو مفيش حاجة محفوظة
                tasks = [
                    { title: "مذاكرة 3 ساعات", done: false },
                    { title: "شرب 2 لتر مياه", done: true }
                ];
                renderTasks();
            }
        };

        // دالة إضافة مهمة جديدة
        function addTask() {
            const taskTitle = prompt("اكتب المهمة الجديدة:");
            if (taskTitle && taskTitle.trim() !== "") {
                tasks.push({ title: taskTitle, done: false });
                saveAndRender();
            }
        }

        // دالة حذف مهمة
        function deleteTask(index) {
            tasks.splice(index, 1);
            saveAndRender();
        }

        // دالة تغيير حالة المهمة (تم / لم يتم)
        function toggleTask(index) {
            tasks[index].done = !tasks[index].done;
            saveAndRender();
        }

        // دالة عرض المهام على الشاشة
        function renderTasks() {
            const taskList = document.getElementById('task-list');
            taskList.innerHTML = ""; // تنظيف القائمة

            tasks.forEach((task, index) => {
                const li = document.createElement('li');
                li.className = 'task-item';
                
                li.innerHTML = `
                    <input type="checkbox" ${task.done ? 'checked' : ''} onchange="toggleTask(${index})">
                    <span class="task-text ${task.done ? 'done' : ''}">${task.title}</span>
                    <button class="delete-btn" onclick="deleteTask(${index})">✕</button>
                `;
                
                taskList.appendChild(li);
            });
        }

        // دالة حفظ المهام وإعادة العرض
        function saveAndRender() {
            localStorage.setItem('tasks', JSON.stringify(tasks));
            renderTasks();
        }

        // دالة تغيير اللون
        function changeColor(color) {
            // تغيير لون صورة البروفايل
            document.getElementById('avatar-box').style.background = color;
            
            // تغيير لون خلفية الحقول
            document.querySelectorAll('.field input').forEach(input => {
                input.style.background = color + '40'; // إضافة شفافية
            });

            // تغيير لون زر الإضافة
            document.querySelector('.add-btn').style.background = color;

            // حفظ اللون في ذاكرة المتصفح
            localStorage.setItem('themeColor', color);
        }
    </script>

</body>
</html>
